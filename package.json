{
  "name": "casa-allegra-platform",
  "productName": "CASA ALLEGRA",
  "version": "2.0.0",
  "private": true,
  "description": "CASA ALLEGRA e-commerce y gestión comercial multi-tienda.",
  "main": "main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "dist:portable": "electron-builder --win portable --x64"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "next": "^15.5.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "ar.casaallegra.gestion",
    "productName": "CASA ALLEGRA",
    "artifactName": "CASA-ALLEGRA-Setup-${version}-x64.exe",
    "asar": true,
    "compression": "maximum",
    "directories": {"output": "dist"},
    "files": ["**/*", "!dist/**", "!README-ELECTRON.md", "!build_windows.bat"],
    "win": {"target": [{"target":"nsis","arch":["x64"]}],"icon":"icon-512.png","verifyUpdateCodeSignature":false},
    "nsis": {"oneClick":false,"perMachine":false,"allowElevation":false,"createDesktopShortcut":true,"createStartMenuShortcut":true,"shortcutName":"CASA ALLEGRA","menuCategory":"CASA ALLEGRA","runAfterFinish":true,"deleteAppDataOnUninstall":false,"artifactName":"CASA-ALLEGRA-Setup-${version}-x64.exe"}
  }
}
